APP_NAME="Ticket Reservation API"
APP_ENV=testing
APP_KEY=base64:Ms+3NajF5SYL4rDjiqYjJa3dlesJrzkRZTGBZCzp5N0=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL only. SQLite silently no-ops the row locking this system depends on.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tickets_test
DB_USERNAME=tickets
DB_PASSWORD=secret

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Sanctum personal access tokens expire after 24 h.
SANCTUM_EXPIRATION_MINUTES=1440

# --- Payments -------------------------------------------------------------
PAYMENTS_DRIVER=fake
PAYMENTS_RETURN_BASE_URL=http://localhost:3000
PAYMENTS_MAX_SESSION_LIFETIME_MINUTES=1440
PAYMENTS_HTTP_CONNECT_TIMEOUT=5
PAYMENTS_HTTP_TIMEOUT=10

FAKE_WEBHOOK_SECRET=change-me-fake-secret
FAKE_CHECKOUT_BASE_URL=http://localhost:8000/fake-checkout

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Reservations ---------------------------------------------------------
RESERVATION_HOLD_MINUTES=30
RESERVATION_MAX_SEATS=10
CHECKOUT_MAX_ATTEMPTS=5
RECONCILE_INITIATED_AFTER_MINUTES=10
REFUND_MAX_ATTEMPTS=5
